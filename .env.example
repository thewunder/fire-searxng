# Copy to .env (cp .env.example .env) and edit. .env is gitignored.
#
# These values describe the ROCmFP4 + MTP llama.cpp container the Lando stack
# serves the LLM from (the `llama-cpp` service in .lando.base.yml, built from
# tools/Dockerfile.rocmfp4).
#
# NOTE: Lando does not read this file. The `llama-cpp` service in
# .lando.base.yml has these values BAKED IN (build args + command); if you
# change one here, change it there too. This file is the source of truth when
# you build/run tools/Dockerfile.rocmfp4 directly with plain docker.

# --- model -------------------------------------------------------------------

# MODELS_DIR: host folder mounted read-only at /models. The default is the
# Hugging Face cache repo dir for the ROCmFP4 GGUF; it holds snapshots/ and
# blobs/, so the snapshot symlinks below resolve inside the container.
MODELS_DIR=/home/youruser/.cache/huggingface/hub/models--plunderstruck--Qwen3.6-35B-A3B-MTP-ROCmFP4-GGUF

# ROCMFP4_MODEL: the GGUF file to serve, RELATIVE to MODELS_DIR. Required.
ROCMFP4_MODEL=snapshots/fe537448c6eb259e6591fea8b9ed320a64ef4856/Qwen3.6-35B-A3B-MTP-ROCmFP4-STRIX-embF16-headQ6.gguf

# ROCMFP4_CHAT_TEMPLATE: jinja chat template shipped with the model, RELATIVE to MODELS_DIR.
ROCMFP4_CHAT_TEMPLATE=snapshots/fe537448c6eb259e6591fea8b9ed320a64ef4856/chat_template.jinja

# ROCMFP4_ALIAS: model name reported by the OpenAI API (/v1/models, response "model").
ROCMFP4_ALIAS=qwen3.6-35b-a3b-mtp

# --- server knobs ------------------------------------------------------------

# ROCMFP4_PORT: host port for the OpenAI-compatible API. OpenWebUI connects here.
ROCMFP4_PORT=8395

# ROCMFP4_CTX: context window. Model max is 262144; lower it to save KV memory.
ROCMFP4_CTX=262144

# --- GPU access (Strix Halo) -------------------------------------------------

# Group IDs so the container can reach /dev/dri and /dev/kfd. Find yours:
#   getent group render | cut -d: -f3   -> RENDER_GID
#   getent group video  | cut -d: -f3   -> VIDEO_GID
RENDER_GID=990
VIDEO_GID=44

# --- image build -------------------------------------------------------------

# ROCMFP4_THEROCK_VERSION: TheRock ROCm dist tarball pinned into the image
# (gfx1151 is in ROCm's support matrix from 7.13). This is the LAST 7.13
# nightly; TheRock has no plain "7.13.0" artifact, so a dated pin is as stable
# as this line gets.
ROCMFP4_THEROCK_VERSION=7.13.0a20260515

# ROCMFP4_GFX: GPU ISA to compile for. gfx1151 = Strix Halo.
ROCMFP4_GFX=gfx1151
