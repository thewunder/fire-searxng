[Unit]
Description=fire-searxng (SearXNG + Firecrawl via Lando)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/IdeaProjects/fire-searxng
Environment=PATH=%h/.lando/bin:/usr/local/bin:/usr/bin:/bin
Environment=DOCKER_HOST=unix:///var/run/docker.sock
# Docker is a system service; user units cannot Require= it. Wait for the daemon.
ExecStartPre=/usr/bin/timeout 120 /usr/bin/bash -c 'until /usr/bin/docker info >/dev/null 2>&1; do sleep 1; done'
ExecStart=%h/.lando/bin/lando start
ExecStop=%h/.lando/bin/lando stop
TimeoutStartSec=infinity
TimeoutStopSec=180
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
